# HTTPS для админки и вебхука. Прод доступен только через VPN (10.193.0.55), Let's Encrypt туда не достучится,
# поэтому сертификат выпускает собственный CA Caddy (tls internal). Чтобы браузер не ругался — один раз
# установить корневой сертификат CA на машины админов (см. README, «Сервер»).
{$SITE_ADDRESS:10.193.0.55} {
	tls internal
	encode gzip
	reverse_proxy si01:8080
}
