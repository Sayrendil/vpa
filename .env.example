# --- Telegram ---
# Токен тестового бота из BotFather (для VPA DEV) — НЕ прод-бот.
BOT_TOKEN=
# Закрытый админ-чат, куда SI-01 шлёт проверки и запросы (id группы, обычно начинается с -100).
ADMIN_CHAT_ID=
# Кто может нажимать «Одобрить / Отклонить» и пользоваться админ-командами. Через запятую.
ADMIN_IDS=

# --- LLM (OpenAI) ---
# Ключ: https://platform.openai.com/api-keys (нужен положительный баланс в Billing).
OPENAI_API_KEY=
LLM_MODEL=gpt-5.5
# low | medium | high — глубина размышлений; ниже = быстрее и дешевле.
# Пусто — для моделей без рассуждений (gpt-4.1 и т.п.), иначе API вернёт ошибку.
LLM_EFFORT=medium
# Модель для сжатия длинной истории и для eval-судьи.
LLM_AUX_MODEL=gpt-5-mini

# --- База ---
# SQLite для разработки; в проде: postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///./si01.db

# --- Tribute ---
# API-ключ из дашборда Tribute (Настройки → API-ключи). Им подписываются вебхуки.
TRIBUTE_API_KEY=
# Ссылка на оплату подписки, которую SI-01 отправит после одобрения.
TRIBUTE_PAYMENT_URL=
# Какие subscription_id из Tribute считаются подпиской VPA (через запятую). Пусто = любые.
TRIBUTE_SUBSCRIPTION_IDS=
# HTTP-сервер внутри контейнера: вебхук Tribute (/webhook/tribute) и админка (/admin)
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
# Адрес, по которому админы открывают сервер (через VPN). На него Caddy выпускает сертификат своим CA.
SITE_ADDRESS=10.193.0.55

# --- Веб-админка (/admin) ---
# Пароль входа. Пусто = админка выключена. Длинный и случайный: openssl rand -base64 24
ADMIN_PANEL_PASSWORD=
# Ключ подписи cookie (необязательно; пусто = выводится из пароля)
ADMIN_PANEL_SECRET=
# Часовой пояс дат в админке, часы от UTC
ADMIN_PANEL_UTC_OFFSET=3

# --- Голос (распознавание в обычном общении) ---
# Выключено: бот просит написать текстом. Включить — нужен Whisper-совместимый API.
STT_ENABLED=false
STT_BASE_URL=https://api.openai.com/v1
# Пусто = берётся OPENAI_API_KEY.
STT_API_KEY=
STT_MODEL=whisper-1

# --- Сессия и хранение ---
SESSION_IDLE_HOURS=48
LOG_RETENTION_DAYS=60
